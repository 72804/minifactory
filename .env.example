# Shared PostgreSQL used by every Mini App and the admin dashboard.
# Do not leave the example postgres/postgres@localhost URL in place.
# Homebrew Postgres on macOS usually authenticates as your OS user, and the
# role `postgres` often does not exist (Prisma P1010).
DATABASE_URL="postgresql://USER@localhost:5432/minifactory?schema=public"

# Optional. Not required in schema. Use an unpooled Neon URL when running
# `pnpm db:migrate:deploy` if DATABASE_URL points at a `-pooler.` host and
# the deploy script cannot derive the direct host. For local Postgres, omit
# or copy DATABASE_URL.
# DIRECT_URL="postgresql://USER@localhost:5432/minifactory?schema=public"

# Required in production. Server-only. Unique per Vercel Mini App / bot.
TELEGRAM_BOT_TOKEN=""

# Optional Bot API webhook verification token. Unique per bot.
TELEGRAM_WEBHOOK_SECRET=""

# Signed initData older than this many seconds is rejected. Default 86400.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS="86400"

# Public origin of this Mini App (no trailing slash). Unique per Vercel project.
APP_BASE_URL="http://localhost:3000"

# Protects apps/admin. Required in production for that app. Never send as a query param.
ADMIN_SECRET=""

# Development-only. Ignored in production. Both must be true for the browser mock header.
ALLOW_TELEGRAM_MOCK="true"
NEXT_PUBLIC_TELEGRAM_MOCK="true"

# Public bot username for share links (not a secret).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# Optional server-only AI provider. Never expose to the browser.
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-5.6-luna"
OPENAI_MODEL=""

# Optional Vercel Blob (future media uploads).
BLOB_READ_WRITE_TOKEN=""

# Ads provider id. disabled | mock
ADS_PROVIDER="disabled"

# Optional. Shown by /paysupport for this Mini App only. Do not put private contacts in shared packages.
# SUPPORT_TELEGRAM="@your_support"
